# Local development only. Replace these passwords before using the stack beyond localhost.
MYSQL_DATABASE=fashion_pos_db
MYSQL_USER=btriple_app
MYSQL_PASSWORD=local_dev_password_change_me
MYSQL_ROOT_PASSWORD=local_root_password_change_me

# Local HTTP needs Secure cookies disabled. Set to 1 behind HTTPS.
SESSION_SECURE=0
APP_URL=http://127.0.0.1:8000

# Optional SMTP settings for employee invitation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=B'TRIPLE POS
